{
  "module": {
    "name": "entry", "type": "entry", "mainElement": "EntryAbility",
    "deviceTypes": ["phone", "tablet"],
    "deliveryWithInstall": true, "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [{"name":"ohos.permission.INTERNET"}, {"name":"ohos.permission.GET_NETWORK_INFO"}],
    "abilities": [{
      "name": "EntryAbility", "srcEntry": "./ets/entryability/EntryAbility.ets",
      "icon": "$media:brand_logo", "label": "$string:app_name",
      "startWindowIcon": "$media:brand_logo", "startWindowBackground": "$color:start_window_background",
      "exported": true, "launchType": "singleton",
      "skills": [{"entities":["entity.system.home"],"actions":["ohos.want.action.home"]}]
    }]
  }
}
